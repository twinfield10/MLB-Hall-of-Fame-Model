# --- R session cruft (never reproducible, never needed) ---
.RData
.Rhistory
.Rproj.user/
.Ruserdata/
*.Rproj.bak

# --- macOS ---
.DS_Store

# --- renv: track the lockfile + settings, not the restored library ---
renv/library/
renv/staging/
renv/python/
renv/sandbox/

# --- targets pipeline cache (regenerated by tar_make) ---
_targets/

# --- generated model artifacts & reports (reproducible from the pipeline) ---
outputs/models/
outputs/reports/

# --- live-pull cache (fetched on demand, fetch-date stamped) ---
Data/cache/

# --- back-compat symlink to the versioned snapshot (the real dir is tracked) ---
Data/lahman_1871-2024_csv

# --- stale stray output at repo root (canonical copy lives in outputs/) ---
/MLB_HOFPredictions_Batters_2026.csv
